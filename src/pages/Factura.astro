---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="invoice-shell">
		<header class="topbar"><a class="brand-wrap" href="/Landing"><span class="brand-mark">D</span><span>Delicias Susu</span></a><a class="back-link" href="/Historial">← Historial</a></header>
		<section class="invoice-card" aria-labelledby="invoice-title">
			<div class="invoice-heading"><div><p class="eyebrow">Comprobante de compra</p><h1 id="invoice-title">Factura visual</h1><p id="invoice-date"></p></div><span class="paid-badge">PAGO SIMULADO</span></div>
			<div class="invoice-number"><span>Pedido</span><strong id="invoice-number">-</strong></div>
			<div class="invoice-grid"><div><span>Cliente</span><strong id="invoice-customer">-</strong></div><div><span>Método de pago</span><strong id="invoice-payment">-</strong></div><div><span>Entrega</span><strong id="invoice-delivery">-</strong></div><div><span>Estado</span><strong>Confirmado</strong></div></div>
			<div class="invoice-total"><span>Total pagado</span><strong id="invoice-total">$0 MXN</strong></div>
			<p class="invoice-note">Este documento es una factura demostrativa para el flujo de compra de Delicias Susu.</p>
			<div class="invoice-actions"><button class="btn btn-primary" id="print-invoice" type="button">Imprimir factura</button><a class="btn btn-secondary" href="/Catalogo">Seguir comprando</a></div>
			<p id="invoice-feedback" role="status" aria-live="polite"></p>
		</section>
	</main>
</Layout>

<script>
	type Order = { orderNumber?: string; name?: string; payment?: string; delivery?: string; total?: string; createdAt?: string };
	const orders = JSON.parse(localStorage.getItem('delicias-orders') ?? '[]') as Order[];
	const requested = new URLSearchParams(window.location.search).get('pedido');
	const order = orders.find((item) => item.orderNumber === requested) ?? orders[0] ?? null;
	const set = (id: string, value: string) => { const element = document.querySelector<HTMLElement>(`#${id}`); if (element) element.textContent = value; };
	if (order) {
		set('invoice-number', order.orderNumber ?? '-');
		set('invoice-customer', order.name ?? 'Cliente');
		set('invoice-payment', order.payment ?? 'Pago simulado');
		set('invoice-delivery', order.delivery ?? 'Por confirmar');
		set('invoice-total', order.total ?? '$0 MXN');
		set('invoice-date', order.createdAt ? new Date(order.createdAt).toLocaleDateString('es-MX', { dateStyle: 'long' }) : '');
	}
	document.querySelector<HTMLButtonElement>('#print-invoice')?.addEventListener('click', () => set('invoice-feedback', 'Factura lista para imprimir (simulado).'));
</script>

<style>
	.invoice-shell { max-width: 900px; min-height: 100vh; margin: 0 auto; padding: 24px 20px 56px; }
	.topbar { display: flex; justify-content: space-between; align-items: center; }
	.brand-wrap { display: flex; align-items: center; gap: 12px; color: var(--text); font-weight: 800; }
	.brand-mark { display: grid; width: 42px; height: 42px; place-items: center; border-radius: 14px; background: linear-gradient(135deg, var(--primary), #eea368); color: white; }
	.back-link { color: var(--primary-dark); font-weight: 800; }
	.invoice-card { max-width: 700px; margin: 12vh auto 0; padding: clamp(24px, 5vw, 48px); border-radius: 26px; background: white; box-shadow: var(--shadow); }
	.invoice-heading { display: flex; justify-content: space-between; gap: 16px; align-items: start; }
	.eyebrow { margin: 0 0 10px; color: var(--primary-dark); font-size: .8rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
	h1 { margin: 0; font-size: clamp(2rem, 5vw, 3.5rem); letter-spacing: -.05em; }
	#invoice-date { color: var(--muted); }
	.paid-badge, .order-status { color: var(--primary-dark); font-size: .72rem; font-weight: 900; }
	.invoice-number { display: flex; justify-content: space-between; margin: 32px 0 20px; padding: 15px; border-radius: 12px; background: #fff0df; }
	.invoice-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; padding-bottom: 24px; border-bottom: 1px solid var(--line); }
	.invoice-grid div { display: grid; gap: 5px; } .invoice-grid span { color: var(--muted); font-size: .82rem; } .invoice-grid strong { font-size: .94rem; }
	.invoice-total { display: flex; justify-content: space-between; padding: 24px 0; font-size: 1.15rem; } .invoice-total strong { color: var(--primary-dark); font-size: 1.4rem; }
	.invoice-note, #invoice-feedback { color: var(--muted); font-size: .86rem; line-height: 1.5; }
	.invoice-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; } .btn { padding: 12px 18px; border: 0; border-radius: 999px; font: inherit; font-weight: 800; cursor: pointer; } .btn-primary { background: var(--primary); color: white; } .btn-secondary { background: #fff0df; color: var(--primary-dark); }
	@media (max-width: 600px) { .invoice-heading { flex-direction: column; } .invoice-grid { grid-template-columns: 1fr; } }
</style>
