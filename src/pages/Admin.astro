---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="admin-shell">
		<aside class="sidebar" aria-label="Navegación del administrador">
			<a class="brand-wrap" href="/Landing" aria-label="Volver al inicio de Delicias Susu">
				<span class="brand-mark">D</span>
				<span>Delicias Susu</span>
			</a>

			<div class="profile-card">
				<div class="avatar">AS</div>
				<div>
					<strong>Admin Susu</strong>
					<span>Panel de control</span>
				</div>
			</div>

			<nav class="menu" aria-label="Secciones del panel">
				<p class="menu-label">Gestión</p>
				<a class="menu-link active" href="#resumen"><span class="menu-icon">⌂</span>Resumen</a>
				<a class="menu-link" href="#productos"><span class="menu-icon">✦</span>Productos</a>
				<a class="menu-link" href="#pedidos"><span class="menu-icon">▣</span>Pedidos <b>5</b></a>
				<a class="menu-link" href="#promociones"><span class="menu-icon">%</span>Promociones</a>
				<a class="menu-link" href="#clientes"><span class="menu-icon">♧</span>Clientes</a>
				<p class="menu-label secondary-label">Cuenta</p>
				<a class="menu-link" href="#configuracion"><span class="menu-icon">⚙</span>Configuración</a>
			</nav>

			<a class="logout" href="/Login"><span>↪</span> Cerrar sesión</a>
		</aside>

		<section class="dashboard" id="resumen">
			<header class="dashboard-header">
				<div>
					<p class="eyebrow">Martes, 18 de junio de 2026</p>
					<h1>Buenos días, Susu <span aria-hidden="true">✦</span></h1>
					<p class="header-note">Aquí tienes lo importante para que todo siga saliendo delicioso.</p>
				</div>
				<div class="header-actions">
					<button class="icon-button" type="button" aria-label="Ver notificaciones">♧<i></i></button>
					<a class="btn btn-primary" href="#nuevo-pedido"><span aria-hidden="true">+</span> Nuevo pedido</a>
				</div>
			</header>

			<section class="metrics" aria-label="Resumen del negocio">
				<article class="metric-card featured">
					<div class="metric-top"><span>Ventas del mes</span><span class="metric-icon">↗</span></div>
					<strong>$28,460</strong>
					<p><span class="positive">+18.4%</span> frente al mes pasado</p>
				</article>
				<article class="metric-card">
					<div class="metric-top"><span>Productos</span><span class="metric-icon soft">✦</span></div>
					<strong>12</strong>
					<p><span class="positive">+2</span> este mes</p>
				</article>
				<article class="metric-card">
					<div class="metric-top"><span>Pedidos</span><span class="metric-icon yellow">▣</span></div>
					<strong>5</strong>
					<p><span class="attention">2 requieren atención</span></p>
				</article>
			</section>

			<section class="content-grid">
				<div class="panel orders-panel" id="pedidos">
					<div class="panel-heading">
						<div><p class="eyebrow">Actividad reciente</p><h2>Pedidos de hoy</h2></div>
						<a class="text-link" href="#todos-los-pedidos">Ver todos <span>→</span></a>
					</div>
					<div class="filter-row" role="group" aria-label="Filtrar pedidos">
						<button class="filter active" type="button" data-filter="Todos">Todos <span>4</span></button>
						<button class="filter" type="button" data-filter="Pendiente">Pendientes <span>1</span></button>
						<button class="filter" type="button" data-filter="Listo">Listos <span>2</span></button>
					</div>
					<div class="table-wrap">
						<table>
							<thead><tr><th>Pedido</th><th>Cliente</th><th>Entrega</th><th>Total</th><th>Estado</th></tr></thead>
							<tbody>
								<tr data-status="Pendiente"><td><strong>#DS-1048</strong><small>Pastel personalizado</small></td><td>María Fernández</td><td>Hoy, 12:30</td><td><strong>$850</strong></td><td><span class="status pending">Pendiente</span></td></tr>
								<tr data-status="Listo"><td><strong>#DS-1047</strong><small>Caja de cupcakes</small></td><td>Diego Ramírez</td><td>Hoy, 13:00</td><td><strong>$420</strong></td><td><span class="status ready">Listo</span></td></tr>
								<tr data-status="En preparación"><td><strong>#DS-1046</strong><small>Tarta de frutos rojos</small></td><td>Camila Torres</td><td>Hoy, 14:15</td><td><strong>$690</strong></td><td><span class="status preparing">En preparación</span></td></tr>
								<tr data-status="Listo"><td><strong>#DS-1045</strong><small>Brownies surtidos</small></td><td>Jorge Castillo</td><td>Hoy, 15:00</td><td><strong>$320</strong></td><td><span class="status ready">Listo</span></td></tr>
							</tbody>
						</table>
					</div>
				</div>

				<aside class="panel stock-panel" id="productos">
					<div class="panel-heading"><div><p class="eyebrow">Catálogo</p><h2>Más vendidos</h2></div><a class="round-link" href="#agregar-producto" aria-label="Agregar producto">+</a></div>
					<div class="product-list">
						<div class="product-item"><span class="product-art cake">🍰</span><div><strong>Pastel de chocolate</strong><small>24 vendidos</small></div><b>$500</b></div>
						<div class="product-item"><span class="product-art cupcake">🧁</span><div><strong>Cupcakes surtidos</strong><small>18 vendidos</small></div><b>$280</b></div>
						<div class="product-item"><span class="product-art tart">🍓</span><div><strong>Tarta de fresa</strong><small>15 vendidos</small></div><b>$420</b></div>
					</div>
					<a class="inventory-link" href="#inventario">Administrar catálogo <span>→</span></a>
				</aside>
			</section>

			<section class="panel product-management" id="inventario" aria-labelledby="inventory-title">
				<div class="panel-heading"><div><p class="eyebrow">Inventario</p><h2 id="inventory-title">Gestión de productos</h2></div><button class="btn btn-primary add-product-button" id="add-product" type="button"><span aria-hidden="true">+</span> Agregar producto</button></div>
				<div class="table-wrap product-table-wrap">
					<table class="product-table">
						<thead><tr><th>Producto</th><th>Categoría</th><th>Precio</th><th>Estado</th><th>Acciones</th></tr></thead>
						<tbody id="product-table-body">
							<tr data-product-row data-name="Pastel de chocolate" data-category="Pasteles" data-price="500"><td><strong>Pastel de chocolate</strong><small>24 vendidos</small></td><td>Pasteles</td><td><strong>$500</strong></td><td><span class="status ready">Disponible</span></td><td><div class="product-actions"><button class="table-action edit-product" type="button">Editar</button><button class="table-action delete-product" type="button">Eliminar</button></div></td></tr>
							<tr data-product-row data-name="Cupcakes surtidos" data-category="Cupcakes" data-price="280"><td><strong>Cupcakes surtidos</strong><small>18 vendidos</small></td><td>Cupcakes</td><td><strong>$280</strong></td><td><span class="status ready">Disponible</span></td><td><div class="product-actions"><button class="table-action edit-product" type="button">Editar</button><button class="table-action delete-product" type="button">Eliminar</button></div></td></tr>
							<tr data-product-row data-name="Tarta de fresa" data-category="Tartas" data-price="420"><td><strong>Tarta de fresa</strong><small>15 vendidos</small></td><td>Tartas</td><td><strong>$420</strong></td><td><span class="status pending">Pocas unidades</span></td><td><div class="product-actions"><button class="table-action edit-product" type="button">Editar</button><button class="table-action delete-product" type="button">Eliminar</button></div></td></tr>
						</tbody>
					</table>
				</div>
			</section>

			<div class="product-form-modal" id="product-form-modal" hidden>
				<div class="form-backdrop" data-close-product-form></div>
				<form class="product-form" id="product-form">
					<div class="form-heading"><div><p class="eyebrow">Catálogo</p><h2 id="product-form-title">Agregar producto</h2></div><button class="close-form" type="button" aria-label="Cerrar formulario" data-close-product-form>×</button></div>
					<label>Nombre del producto<input id="product-name" required /></label>
					<label>Categoría<select id="product-category"><option>Pasteles</option><option>Tartas</option><option>Cupcakes</option><option>Regalos</option></select></label>
					<label>Precio<input id="product-price" type="number" min="1" required /></label>
					<div class="form-actions"><button class="btn form-cancel" type="button" data-close-product-form>Cancelar</button><button class="btn btn-primary" type="submit">Guardar producto</button></div>
				</form>
			</div>

			<section class="panel promotions-panel" id="promociones" aria-labelledby="promotions-title">
				<div class="panel-heading"><div><p class="eyebrow">Ventas especiales</p><h2 id="promotions-title">Promociones activas</h2></div><a class="round-link" href="#nueva-promocion" aria-label="Agregar promoción">+</a></div>
				<div class="promotion-list">
					<div class="promotion-item"><span class="promotion-icon">%</span><div><strong>15% en cajas para regalar</strong><small>Vigente hasta el 30 de junio</small></div><span class="promotion-status">Activa</span></div>
					<div class="promotion-item"><span class="promotion-icon yellow">✦</span><div><strong>Envío gratis en pedidos mayores a $800</strong><small>Aplicada automáticamente</small></div><span class="promotion-status">Activa</span></div>
				</div>
			</section>
		</section>
	</main>
</Layout>

<script>
	const filters = document.querySelectorAll<HTMLButtonElement>('.filter');
	const rows = document.querySelectorAll<HTMLTableRowElement>('#pedidos tbody tr');
	const productFormModal = document.querySelector<HTMLElement>('#product-form-modal');
	const productForm = document.querySelector<HTMLFormElement>('#product-form');
	const productFormTitle = document.querySelector<HTMLElement>('#product-form-title');
	const productName = document.querySelector<HTMLInputElement>('#product-name');
	const productCategory = document.querySelector<HTMLSelectElement>('#product-category');
	const productPrice = document.querySelector<HTMLInputElement>('#product-price');
	const productTableBody = document.querySelector<HTMLElement>('#product-table-body');
	let editingProduct: HTMLTableRowElement | null = null;

	const openProductForm = (row?: HTMLTableRowElement) => {
		editingProduct = row ?? null;
		if (productFormTitle) productFormTitle.textContent = row ? 'Editar producto' : 'Agregar producto';
		if (productName) productName.value = row?.dataset.name ?? '';
		if (productCategory) productCategory.value = row?.dataset.category ?? 'Pasteles';
		if (productPrice) productPrice.value = row?.dataset.price ?? '';
		if (productFormModal) productFormModal.hidden = false;
	};

	const closeProductForm = () => {
		if (productFormModal) productFormModal.hidden = true;
		editingProduct = null;
	};

	const connectProductActions = (row: HTMLTableRowElement) => {
		row.querySelector<HTMLButtonElement>('.edit-product')?.addEventListener('click', () => openProductForm(row));
		row.querySelector<HTMLButtonElement>('.delete-product')?.addEventListener('click', () => {
			if (window.confirm(`¿Seguro que deseas eliminar "${row.dataset.name}"?`)) row.remove();
		});
	};

	document.querySelector<HTMLButtonElement>('#add-product')?.addEventListener('click', () => openProductForm());
	document.querySelectorAll<HTMLElement>('[data-close-product-form]').forEach((element) => element.addEventListener('click', closeProductForm));
	document.querySelectorAll<HTMLTableRowElement>('[data-product-row]').forEach(connectProductActions);
	productForm?.addEventListener('submit', (event) => {
		event.preventDefault();
		const name = productName?.value.trim() ?? '';
		const category = productCategory?.value ?? 'Pasteles';
		const price = productPrice?.value ?? '0';
		if (!name || !productTableBody) return;
		if (editingProduct) {
			editingProduct.dataset.name = name;
			editingProduct.dataset.category = category;
			editingProduct.dataset.price = price;
			const cells = editingProduct.querySelectorAll('td');
			if (cells[0]) cells[0].querySelector('strong')!.textContent = name;
			if (cells[1]) cells[1].textContent = category;
			if (cells[2]) cells[2].querySelector('strong')!.textContent = `$${price}`;
		} else {
			const row = document.createElement('tr');
			row.dataset.productRow = '';
			row.dataset.name = name;
			row.dataset.category = category;
			row.dataset.price = price;
			row.innerHTML = `<td><strong>${name}</strong><small>Nuevo producto</small></td><td>${category}</td><td><strong>$${price}</strong></td><td><span class="status ready">Disponible</span></td><td><div class="product-actions"><button class="table-action edit-product" type="button">Editar</button><button class="table-action delete-product" type="button">Eliminar</button></div></td>`;
			productTableBody.append(row);
			connectProductActions(row);
		}
		closeProductForm();
	});

	filters.forEach((filter) => {
		filter.addEventListener('click', () => {
			filters.forEach((item) => item.classList.remove('active'));
			filter.classList.add('active');
			const selected = filter.dataset.filter;
			rows.forEach((row) => {
				row.hidden = selected !== 'Todos' && row.dataset.status !== selected;
			});
		});
	});
</script>

<style>
	/* Layout */
	.admin-shell {
		display: grid;
		grid-template-columns: 250px minmax(0, 1fr);
		min-height: 100vh;
	}

	.sidebar {
		display: flex;
		flex-direction: column;
		padding: 30px 18px 24px;
		background: #fff;
		border-right: 1px solid var(--line);
	}

	.brand-wrap {
		display: inline-flex;
		align-items: center;
		gap: 11px;
		padding: 0 12px;
		color: var(--text);
		font-weight: 800;
		letter-spacing: 0.02em;
	}

	.brand-mark {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border-radius: 13px;
		background: linear-gradient(135deg, var(--primary), #eea368);
		color: #fff;
		box-shadow: var(--shadow);
	}

	/* Sidebar */
	.profile-card {
		display: flex;
		align-items: center;
		gap: 11px;
		margin: 46px 8px 36px;
		padding: 12px;
		border-radius: 16px;
		background: var(--panel-soft);
	}

	.avatar {
		display: grid;
		place-items: center;
		width: 38px;
		height: 38px;
		border-radius: 12px;
		background: #f7cb82;
		color: var(--text);
		font-size: 0.74rem;
		font-weight: 800;
	}

	.profile-card div:last-child {
		display: grid;
		gap: 3px;
	}

	.profile-card strong {
		font-size: 0.88rem;
	}

	.profile-card span {
		color: var(--muted);
		font-size: 0.73rem;
	}

	.menu {
		display: grid;
		gap: 5px;
	}

	.menu-label {
		margin: 0 12px 9px;
		color: #a89089;
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.secondary-label {
		margin-top: 28px;
	}

	.menu-link {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 12px;
		border-radius: 12px;
		color: var(--muted);
		font-size: 0.9rem;
		font-weight: 700;
	}

	.menu-link:hover,
	.menu-link.active {
		background: var(--panel-soft);
		color: var(--primary-dark);
	}

	.menu-link b {
		margin-left: auto;
		padding: 3px 7px;
		border-radius: 999px;
		background: #f7cb82;
		color: var(--text);
		font-size: 0.68rem;
	}

	.menu-icon {
		width: 18px;
		color: var(--primary);
		font-size: 1.1rem;
		text-align: center;
	}

	.logout {
		display: flex;
		align-items: center;
		gap: 9px;
		margin-top: auto;
		padding: 12px;
		color: var(--muted);
		font-size: 0.86rem;
		font-weight: 700;
	}

	.logout span {
		color: var(--primary);
		font-size: 1.2rem;
	}

	/* Dashboard header */
	.dashboard {
		width: 100%;
		max-width: 1400px;
		margin: 0 auto;
		padding: 46px clamp(24px, 5vw, 70px) 60px;
	}

	.dashboard-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 24px;
	}

	.eyebrow {
		margin: 0 0 10px;
		color: var(--primary-dark);
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	h1,
	h2 {
		margin: 0;
		line-height: 1.06;
		letter-spacing: -0.04em;
	}

	h1 {
		font-size: clamp(2rem, 4vw, 3.2rem);
	}

	h1 span {
		color: var(--secondary);
		font-size: 0.7em;
	}

	h2 {
		font-size: 1.35rem;
	}

	.header-note {
		margin: 12px 0 0;
		color: var(--muted);
		font-size: 0.94rem;
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 14px;
	}

	.icon-button,
	.round-link {
		position: relative;
		display: grid;
		place-items: center;
		width: 42px;
		height: 42px;
		border: 1px solid var(--line);
		border-radius: 50%;
		background: #fff;
		color: var(--primary-dark);
		font: inherit;
		font-size: 1.1rem;
		cursor: pointer;
	}

	.icon-button i {
		position: absolute;
		top: 8px;
		right: 9px;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--primary);
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		padding: 13px 18px;
		border-radius: 999px;
		font-size: 0.85rem;
		font-weight: 800;
	}

	.btn-primary {
		background: linear-gradient(135deg, var(--primary), #f08d69);
		color: #fff;
		box-shadow: 0 12px 25px rgba(217, 109, 93, 0.2);
	}

	/* Metrics */
	.metrics {
		display: grid;
		grid-template-columns: 1.25fr 1fr 1fr;
		gap: 16px;
		margin: 42px 0 28px;
	}

	.metric-card {
		padding: 22px 24px;
		border: 1px solid var(--line);
		border-radius: 18px;
		background: rgba(255, 255, 255, 0.76);
		box-shadow: 0 12px 32px rgba(126, 61, 45, 0.05);
	}

	.metric-card.featured {
		background: linear-gradient(135deg, #e98770, #d96d5d);
		color: #fff;
	}

	.metric-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		color: var(--muted);
		font-size: 0.78rem;
		font-weight: 700;
	}

	.featured .metric-top {
		color: rgba(255, 255, 255, 0.8);
	}

	.metric-icon {
		color: var(--primary-dark);
		font-size: 1.15rem;
	}

	.metric-icon.soft { color: #d39f60; }
	.metric-icon.yellow { color: #c88b3a; }

	.metric-card > strong {
		display: block;
		margin: 15px 0 5px;
		font-size: 2rem;
		letter-spacing: -0.04em;
	}

	.metric-card p {
		margin: 0;
		color: var(--muted);
		font-size: 0.75rem;
	}

	.featured p { color: rgba(255, 255, 255, 0.85); }
	.positive { color: #3a9272; font-weight: 800; }
	.featured .positive { color: #fff3c8; }
	.attention { color: var(--primary-dark); font-weight: 800; }

	/* Orders and catalog */
	.content-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.65fr) minmax(280px, 0.85fr);
		gap: 20px;
	}

	.panel {
		padding: 26px;
		border: 1px solid var(--line);
		border-radius: 20px;
		background: rgba(255, 255, 255, 0.8);
		box-shadow: 0 14px 40px rgba(126, 61, 45, 0.05);
	}

	.panel-heading {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 15px;
	}

	.text-link,
	.inventory-link {
		color: var(--primary-dark);
		font-size: 0.78rem;
		font-weight: 800;
	}

	.filter-row {
		display: flex;
		gap: 8px;
		margin: 25px 0 13px;
	}

	.filter {
		padding: 7px 11px;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: var(--muted);
		font: inherit;
		font-size: 0.73rem;
		cursor: pointer;
	}

	.filter span {
		margin-left: 3px;
		color: #a89089;
	}

	.filter.active {
		background: var(--panel-soft);
		color: var(--primary-dark);
		font-weight: 800;
	}

	.table-wrap { overflow-x: auto; }

	table {
		width: 100%;
		min-width: 610px;
		border-collapse: collapse;
		text-align: left;
	}

	th {
		padding: 10px;
		color: #a89089;
		font-size: 0.66rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	td {
		padding: 15px 10px;
		border-top: 1px solid var(--line);
		color: var(--muted);
		font-size: 0.78rem;
		white-space: nowrap;
	}

	td:first-child { color: var(--text); }
	td strong { display: block; color: var(--text); font-size: 0.8rem; }
	td small { display: block; margin-top: 4px; color: #a89089; font-size: 0.68rem; }

	.status {
		display: inline-flex;
		padding: 5px 8px;
		border-radius: 999px;
		font-size: 0.65rem;
		font-weight: 800;
	}

	.pending { background: #fff0cf; color: #a86b13; }
	.ready { background: #e4f4e9; color: #47815b; }
	.preparing { background: #fce4de; color: #b65345; }

	.stock-panel {
		display: flex;
		flex-direction: column;
	}

	.product-list {
		display: grid;
		gap: 18px;
		margin: 28px 0;
	}

	.product-item {
		display: grid;
		grid-template-columns: 44px 1fr auto;
		align-items: center;
