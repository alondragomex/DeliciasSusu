---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="admin-shell">
		<aside class="sidebar" aria-label="Navegación del administrador">
			<a class="brand-wrap" href="/Landing" aria-label="Volver al inicio de Delicias Susu">
				<span class="brand-mark">D</span>
				<span>Delicias Susu</span>
			</a>

			<div class="profile-card">
				<div class="avatar">AS</div>
				<div>
					<strong>Admin Susu</strong>
					<span>Panel de control</span>
				</div>
			</div>

			<nav class="menu" aria-label="Secciones del panel">
				<p class="menu-label">Gestión</p>
				<a class="menu-link active" href="#resumen"><span class="menu-icon">⌂</span>Resumen</a>
				<a class="menu-link" href="#productos"><span class="menu-icon">✦</span>Productos</a>
				<a class="menu-link" href="#pedidos"><span class="menu-icon">▣</span>Pedidos <b>5</b></a>
				<a class="menu-link" href="#promociones"><span class="menu-icon">%</span>Promociones</a>
				<a class="menu-link" href="#subastas"><span class="menu-icon">↗</span>Subastas</a>
				<a class="menu-link" href="#clientes"><span class="menu-icon">♧</span>Clientes</a>
				<p class="menu-label secondary-label">Cuenta</p>
				<a class="menu-link" href="#configuracion"><span class="menu-icon">⚙</span>Configuración</a>
			</nav>

			<a class="logout" href="/Login"><span>↪</span> Cerrar sesión</a>
		</aside>

		<section class="dashboard" id="resumen">
			<header class="dashboard-header">
				<div>
					<p class="eyebrow">Martes, 18 de junio de 2026</p>
					<h1>Buenos días, Susu <span aria-hidden="true">✦</span></h1>
					<p class="header-note">Aquí tienes lo importante para que todo siga saliendo delicioso.</p>
				</div>
				<div class="header-actions">
					<button class="icon-button" type="button" aria-label="Ver notificaciones">♧<i></i></button>
					<a class="btn btn-primary" href="/Landing"><span aria-hidden="true">←</span> Volver al inicio</a>
				</div>
			</header>

			<section class="metrics" aria-label="Resumen del negocio">
				<article class="metric-card featured">
					<div class="metric-top"><span>Ventas del mes</span><span class="metric-icon">↗</span></div>
					<strong>$28,460</strong>
					<p><span class="positive">+18.4%</span> frente al mes pasado</p>
				</article>
				<article class="metric-card">
					<div class="metric-top"><span>Productos</span><span class="metric-icon soft">✦</span></div>
					<strong>12</strong>
					<p><span class="positive">+2</span> este mes</p>
				</article>
				<article class="metric-card">
					<div class="metric-top"><span>Pedidos</span><span class="metric-icon yellow">▣</span></div>
					<strong>5</strong>
					<p><span class="attention">2 requieren atención</span></p>
				</article>
			</section>

			<section class="content-grid">
				<div class="panel orders-panel" id="pedidos">
					<div class="panel-heading">
						<div><p class="eyebrow">Actividad reciente</p><h2>Pedidos de hoy</h2></div>
						<a class="text-link" href="#todos-los-pedidos">Ver todos <span>→</span></a>
					</div>
					<div class="filter-row" role="group" aria-label="Filtrar pedidos">
						<button class="filter active" type="button" data-filter="Todos">Todos <span>4</span></button>
						<button class="filter" type="button" data-filter="Pendiente">Pendientes <span>1</span></button>
						<button class="filter" type="button" data-filter="Listo">Listos <span>2</span></button>
					</div>
					<div class="table-wrap">
						<table>
							<thead><tr><th>Pedido</th><th>Cliente</th><th>Entrega</th><th>Total</th><th>Estado</th></tr></thead>
							<tbody>
								<tr data-status="Pendiente"><td><strong>#DS-1048</strong><small>Pastel personalizado</small></td><td>María Fernández</td><td>Hoy, 12:30</td><td><strong>$850</strong></td><td><span class="status pending">Pendiente</span></td></tr>
								<tr data-status="Listo"><td><strong>#DS-1047</strong><small>Caja de cupcakes</small></td><td>Diego Ramírez</td><td>Hoy, 13:00</td><td><strong>$420</strong></td><td><span class="status ready">Listo</span></td></tr>
								<tr data-status="En preparación"><td><strong>#DS-1046</strong><small>Tarta de frutos rojos</small></td><td>Camila Torres</td><td>Hoy, 14:15</td><td><strong>$690</strong></td><td><span class="status preparing">En preparación</span></td></tr>
								<tr data-status="Listo"><td><strong>#DS-1045</strong><small>Brownies surtidos</small></td><td>Jorge Castillo</td><td>Hoy, 15:00</td><td><strong>$320</strong></td><td><span class="status ready">Listo</span></td></tr>
							</tbody>
						</table>
					</div>
				</div>

				<aside class="panel stock-panel" id="productos">
					<div class="panel-heading"><div><p class="eyebrow">Catálogo</p><h2>Más vendidos</h2></div><a class="round-link" href="#inventario" aria-label="Agregar producto">+</a></div>
					<div class="product-list">
						<div class="product-item"><span class="product-art cake">🍰</span><div><strong>Pastel de chocolate</strong><small>24 vendidos</small></div><b>$500</b></div>
						<div class="product-item"><span class="product-art cupcake">🧁</span><div><strong>Cupcakes surtidos</strong><small>18 vendidos</small></div><b>$280</b></div>
						<div class="product-item"><span class="product-art tart">🍓</span><div><strong>Tarta de fresa</strong><small>15 vendidos</small></div><b>$420</b></div>
					</div>
					<a class="inventory-link" href="#inventario">Administrar catálogo <span>→</span></a>
				</aside>
			</section>

			<section class="panel product-management" id="inventario" aria-labelledby="inventory-title">
				<div class="panel-heading"><div><p class="eyebrow">Inventario</p><h2 id="inventory-title">Gestión de productos</h2></div><button class="btn btn-primary add-product-button" id="add-product" type="button"><span aria-hidden="true">+</span> Agregar producto</button></div>
				<div class="table-wrap product-table-wrap">
					<table class="product-table">
						<thead><tr><th>Producto</th><th>Categoría</th><th>Precio</th><th>Oferta</th><th>Estado</th><th>Acciones</th></tr></thead>
						<tbody id="product-table-body">
							<tr data-product-row data-name="Pastel de chocolate" data-category="Pasteles" data-price="450" data-offer="true"><td><strong>Pastel de chocolate</strong><small>24 vendidos</small></td><td>Pasteles</td><td><strong>$450</strong></td><td><span class="offer-status active">Oferta activa</span></td><td><span class="status ready">Disponible</span></td><td><div class="product-actions"><button class="table-action edit-product" type="button">Editar</button><button class="table-action delete-product" type="button">Eliminar</button></div></td></tr>
							<tr data-product-row data-name="Tarta de mango" data-category="Tartas" data-price="700" data-offer="false"><td><strong>Tarta de mango</strong><small>Entrega en 24 h</small></td><td>Tartas</td><td><strong>$700</strong></td><td><span class="offer-status">Sin oferta</span></td><td><span class="status ready">Disponible</span></td><td><div class="product-actions"><button class="table-action edit-product" type="button">Editar</button><button class="table-action delete-product" type="button">Eliminar</button></div></td></tr>
							<tr data-product-row data-name="Cupcakes surtidos" data-category="Cupcakes" data-price="300" data-offer="false"><td><strong>Cupcakes surtidos</strong><small>18 vendidos</small></td><td>Cupcakes</td><td><strong>$300</strong></td><td><span class="offer-status">Sin oferta</span></td><td><span class="status ready">Disponible</span></td><td><div class="product-actions"><button class="table-action edit-product" type="button">Editar</button><button class="table-action delete-product" type="button">Eliminar</button></div></td></tr>
							<tr data-product-row data-name="Tarta de frutos rojos" data-category="Tartas" data-price="650" data-offer="false"><td><strong>Tarta de frutos rojos</strong><small>Entrega en 24 h</small></td><td>Tartas</td><td><strong>$650</strong></td><td><span class="offer-status">Sin oferta</span></td><td><span class="status ready">Disponible</span></td><td><div class="product-actions"><button class="table-action edit-product" type="button">Editar</button><button class="table-action delete-product" type="button">Eliminar</button></div></td></tr>
							<tr data-product-row data-name="Brownies surtidos" data-category="Regalos" data-price="288" data-offer="true"><td><strong>Brownies surtidos</strong><small>Entrega en 12 h</small></td><td>Regalos</td><td><strong>$288</strong></td><td><span class="offer-status active">Oferta activa</span></td><td><span class="status ready">Disponible</span></td><td><div class="product-actions"><button class="table-action edit-product" type="button">Editar</button><button class="table-action delete-product" type="button">Eliminar</button></div></td></tr>
							<tr data-product-row data-name="Caja desayuno dulce" data-category="Regalos" data-price="450" data-offer="false"><td><strong>Caja desayuno dulce</strong><small>Entrega en 24 h</small></td><td>Regalos</td><td><strong>$450</strong></td><td><span class="offer-status">Sin oferta</span></td><td><span class="status ready">Disponible</span></td><td><div class="product-actions"><button class="table-action edit-product" type="button">Editar</button><button class="table-action delete-product" type="button">Eliminar</button></div></td></tr>
							<tr data-product-row data-name="Pastel de vainilla" data-category="Pasteles" data-price="550" data-offer="false"><td><strong>Pastel de vainilla</strong><small>Entrega en 24 h</small></td><td>Pasteles</td><td><strong>$550</strong></td><td><span class="offer-status">Sin oferta</span></td><td><span class="status ready">Disponible</span></td><td><div class="product-actions"><button class="table-action edit-product" type="button">Editar</button><button class="table-action delete-product" type="button">Eliminar</button></div></td></tr>
							<tr data-product-row data-name="Galletas decoradas" data-category="Regalos" data-price="252" data-offer="true"><td><strong>Galletas decoradas</strong><small>Entrega en 12 h</small></td><td>Regalos</td><td><strong>$252</strong></td><td><span class="offer-status active">Oferta activa</span></td><td><span class="status ready">Disponible</span></td><td><div class="product-actions"><button class="table-action edit-product" type="button">Editar</button><button class="table-action delete-product" type="button">Eliminar</button></div></td></tr>
							<tr data-product-row data-name="Tarta de fresa" data-category="Tartas" data-price="420" data-offer="false"><td><strong>Tarta de fresa</strong><small>15 vendidos</small></td><td>Tartas</td><td><strong>$420</strong></td><td><span class="offer-status">Sin oferta</span></td><td><span class="status pending">Pocas unidades</span></td><td><div class="product-actions"><button class="table-action edit-product" type="button">Editar</button><button class="table-action delete-product" type="button">Eliminar</button></div></td></tr>
						</tbody>
					</table>
				</div>
			</section>

			<div class="product-form-modal" id="product-form-modal" hidden>
				<div class="form-backdrop" data-close-product-form></div>
				<form class="product-form" id="product-form" novalidate>
					<div class="form-heading"><div><p class="eyebrow">Catálogo</p><h2 id="product-form-title">Agregar producto</h2></div><button class="close-form" type="button" aria-label="Cerrar formulario" data-close-product-form>×</button></div>
					<label>Nombre del producto<input id="product-name" /></label>
					<label>Categoría<select id="product-category"><option>Pasteles</option><option>Tartas</option><option>Cupcakes</option><option>Regalos</option></select></label>
					<label>Precio<input id="product-price" type="text" /></label>
					<label class="offer-toggle"><input id="product-offer" type="checkbox" /><span>Aplicar oferta del 10%</span></label>
					<div class="form-actions"><button class="btn form-cancel" type="button" data-close-product-form>Cancelar</button><button class="btn btn-primary" type="submit">Guardar producto</button></div>
				</form>
			</div>
			<p class="admin-notification" id="admin-notification" role="status" aria-live="polite" hidden></p>

			<section class="panel promotions-panel" id="promociones" aria-labelledby="promotions-title">
				<div class="panel-heading"><div><p class="eyebrow">Ventas especiales</p><h2 id="promotions-title">Promociones activas</h2></div><a class="round-link" href="#nueva-promocion" aria-label="Agregar promoción">+</a></div>
				<div class="promotion-list">
					<div class="promotion-item"><span class="promotion-icon">%</span><div><strong>15% en cajas para regalar</strong><small>Vigente hasta el 30 de junio</small></div><span class="promotion-status">Activa</span></div>
					<div class="promotion-item"><span class="promotion-icon yellow">✦</span><div><strong>Envío gratis en pedidos mayores a $800</strong><small>Aplicada automáticamente</small></div><span class="promotion-status">Activa</span></div>
				</div>
			</section>

			<section class="panel auctions-panel" id="subastas" aria-labelledby="auctions-title">
				<div class="panel-heading"><div><p class="eyebrow">Dinámica especial</p><h2 id="auctions-title">Subastas simuladas</h2></div><span class="auction-live">En vivo</span></div>
				<div class="auction-card">
					<div class="auction-art">🎂<span>Edición especial</span></div>
					<div class="auction-content">
						<p class="category-label">Pastel de temporada</p>
						<h3>Pastel de frutos rojos personalizado</h3>
						<p>Oferta por tiempo limitado para una creación artesanal de tamaño familiar.</p>
						<div class="auction-stats"><div><small>Oferta actual</small><strong id="auction-price">$850 MXN</strong></div><div><small>Termina en</small><strong>02:18:40</strong></div><div><small>Participantes</small><strong id="auction-bidders">7</strong></div></div>
						<div class="auction-actions"><label for="auction-bid">Tu oferta<input id="auction-bid" type="number" min="851" step="10" placeholder="$860" /></label><button class="btn btn-primary" id="place-bid" type="button">Ofertar</button></div>
						<p class="auction-feedback" id="auction-feedback" role="status" aria-live="polite"></p>
					</div>
				</div>
			</section>
		</section>
	</main>
</Layout>

<script>
	const filters = document.querySelectorAll<HTMLButtonElement>('.filter');
	const rows = document.querySelectorAll<HTMLTableRowElement>('#pedidos tbody tr');
	const productFormModal = document.querySelector<HTMLElement>('#product-form-modal');
	const productForm = document.querySelector<HTMLFormElement>('#product-form');
	const productFormTitle = document.querySelector<HTMLElement>('#product-form-title');
	const productName = document.querySelector<HTMLInputElement>('#product-name');
	const productCategory = document.querySelector<HTMLSelectElement>('#product-category');
	const productPrice = document.querySelector<HTMLInputElement>('#product-price');
	const productOffer = document.querySelector<HTMLInputElement>('#product-offer');
	const productTableBody = document.querySelector<HTMLElement>('#product-table-body');
	const adminNotification = document.querySelector<HTMLElement>('#admin-notification');
	const auctionBid = document.querySelector<HTMLInputElement>('#auction-bid');
	const auctionPrice = document.querySelector<HTMLElement>('#auction-price');
	const auctionBidders = document.querySelector<HTMLElement>('#auction-bidders');
	const auctionFeedback = document.querySelector<HTMLElement>('#auction-feedback');
	let editingProduct: HTMLTableRowElement | null = null;

	const showAdminNotification = (message: string) => {
		if (!adminNotification) return;
		adminNotification.textContent = message;
		adminNotification.hidden = false;
		window.setTimeout(() => { adminNotification.hidden = true; }, 2800);
	};

	const openProductForm = (row?: HTMLTableRowElement) => {
		editingProduct = row ?? null;
		if (productFormTitle) productFormTitle.textContent = row ? 'Editar producto' : 'Agregar producto';
		if (productName) productName.value = row?.dataset.name ?? '';
		if (productCategory) productCategory.value = row?.dataset.category ?? 'Pasteles';
		if (productPrice) productPrice.value = row?.dataset.price ?? '';
		if (productOffer) productOffer.checked = row?.dataset.offer === 'true';
		if (productFormModal) productFormModal.hidden = false;
	};

	const closeProductForm = () => {
		if (productFormModal) productFormModal.hidden = true;
		editingProduct = null;
	};

	const connectProductActions = (row: HTMLTableRowElement) => {
		row.querySelector<HTMLButtonElement>('.edit-product')?.addEventListener('click', () => openProductForm(row));
		row.querySelector<HTMLButtonElement>('.delete-product')?.addEventListener('click', () => {
			if (window.confirm(`¿Seguro que deseas eliminar "${row.dataset.name}"?`)) {
				row.remove();
				showAdminNotification('Producto eliminado correctamente (simulado).');
			}
		});
	};

	document.querySelector<HTMLButtonElement>('#add-product')?.addEventListener('click', () => openProductForm());
	document.querySelectorAll<HTMLElement>('[data-close-product-form]').forEach((element) => element.addEventListener('click', closeProductForm));
	document.querySelectorAll<HTMLTableRowElement>('[data-product-row]').forEach(connectProductActions);
	productForm?.addEventListener('submit', (event) => {
		event.preventDefault();
		const name = productName?.value.trim() ?? '';
		const category = productCategory?.value ?? 'Pasteles';
		const price = productPrice?.value ?? '0';
		const isOffer = productOffer?.checked ?? false;
		const wasEditing = Boolean(editingProduct);
		if (!productTableBody) return;
		if (editingProduct) {
			editingProduct.dataset.name = name;
			editingProduct.dataset.category = category;
			editingProduct.dataset.price = price;
			editingProduct.dataset.offer = String(isOffer);
			const cells = editingProduct.querySelectorAll('td');
			if (cells[0]) cells[0].querySelector('strong')!.textContent = name;
			if (cells[1]) cells[1].textContent = category;
			if (cells[2]) cells[2].querySelector('strong')!.textContent = `$${price}`;
			if (cells[3]) cells[3].innerHTML = isOffer ? '<span class="offer-status active">Oferta activa</span>' : '<span class="offer-status">Sin oferta</span>';
		} else {
			const row = document.createElement('tr');
			row.dataset.productRow = '';
			row.dataset.name = name;
			row.dataset.category = category;
			row.dataset.price = price;
			row.dataset.offer = String(isOffer);
			row.innerHTML = `<td><strong>${name}</strong><small>Nuevo producto</small></td><td>${category}</td><td><strong>$${price}</strong></td><td>${isOffer ? '<span class="offer-status active">Oferta activa</span>' : '<span class="offer-status">Sin oferta</span>'}</td><td><span class="status ready">Disponible</span></td><td><div class="product-actions"><button class="table-action edit-product" type="button">Editar</button><button class="table-action delete-product" type="button">Eliminar</button></div></td>`;
			productTableBody.append(row);
			connectProductActions(row);
		}
		closeProductForm();
		showAdminNotification(wasEditing ? 'Producto actualizado correctamente (simulado).' : 'Producto agregado correctamente (simulado).');
	});

	document.querySelector<HTMLButtonElement>('#place-bid')?.addEventListener('click', () => {
		const bid = Number(auctionBid?.value ?? 0);
		const currentPrice = Number((auctionPrice?.textContent ?? '0').replace(/[^\d]/g, ''));
		if (!bid || bid <= currentPrice) {
			if (auctionFeedback) auctionFeedback.textContent = `Ingresa una oferta mayor a $${currentPrice} MXN.`;
			return;
		}
		if (auctionPrice) auctionPrice.textContent = `$${bid.toLocaleString('es-MX')} MXN`;
		if (auctionBidders) auctionBidders.textContent = String(Number(auctionBidders.textContent ?? 0) + 1);
		if (auctionFeedback) auctionFeedback.textContent = 'Oferta registrada correctamente (simulado).';
		if (auctionBid) auctionBid.value = '';
	});

	filters.forEach((filter) => {
		filter.addEventListener('click', () => {
			filters.forEach((item) => item.classList.remove('active'));
			filter.classList.add('active');
			const selected = filter.dataset.filter;
			rows.forEach((row) => {
				row.hidden = selected !== 'Todos' && row.dataset.status !== selected;
			});
		});
	});
</script>

<style>
	/* Layout */
	.admin-shell {
		display: grid;
		grid-template-columns: 250px minmax(0, 1fr);
		min-height: 100vh;
	}

	.sidebar {
		display: flex;
		flex-direction: column;
		padding: 30px 18px 24px;
		background: #fff;
		border-right: 1px solid var(--line);
	}

	.brand-wrap {
		display: inline-flex;
		align-items: center;
		gap: 11px;
		padding: 0 12px;
		color: var(--text);
		font-weight: 800;
		letter-spacing: 0.02em;
	}

	.brand-mark {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border-radius: 13px;
		background: linear-gradient(135deg, var(--primary), #eea368);
		color: #fff;
		box-shadow: var(--shadow);
	}

	/* Sidebar */
	.profile-card {
		display: flex;
		align-items: center;
		gap: 11px;
		margin: 46px 8px 36px;
		padding: 12px;
		border-radius: 16px;
		background: var(--panel-soft);
	}

	.avatar {
		display: grid;
		place-items: center;
		width: 38px;
		height: 38px;
		border-radius: 12px;
		background: #f7cb82;
		color: var(--text);
		font-size: 0.74rem;
		font-weight: 800;
	}

	.profile-card div:last-child {
		display: grid;
		gap: 3px;
	}

	.profile-card strong {
		font-size: 0.88rem;
	}

	.profile-card span {
		color: var(--muted);
		font-size: 0.73rem;
	}

	.menu {
		display: grid;
		gap: 5px;
	}

	.menu-label {
		margin: 0 12px 9px;
		color: #a89089;
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.secondary-label {
		margin-top: 28px;
	}

	.menu-link {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 12px;
		border-radius: 12px;
		color: var(--muted);
		font-size: 0.9rem;
		font-weight: 700;
	}

	.menu-link:hover,
	.menu-link.active {
		background: var(--panel-soft);
		color: var(--primary-dark);
	}

	.menu-link b {
		margin-left: auto;
		padding: 3px 7px;
		border-radius: 999px;
		background: #f7cb82;
		color: var(--text);
		font-size: 0.68rem;
	}

	.menu-icon {
		width: 18px;
		color: var(--primary);
		font-size: 1.1rem;
		text-align: center;
	}

	.logout {
		display: flex;
		align-items: center;
		gap: 9px;
		margin-top: auto;
		padding: 12px;
		color: var(--muted);
		font-size: 0.86rem;
		font-weight: 700;
	}

	.logout span {
		color: var(--primary);
		font-size: 1.2rem;
	}

	/* Dashboard header */
	.dashboard {
		width: 100%;
		max-width: 1400px;
