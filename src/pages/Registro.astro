---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="register-shell">
		<header class="topbar">
			<a class="brand-wrap" href="/" aria-label="Volver al inicio de Delicias Susu">
				<span class="brand-mark">D</span>
				<span>Delicias Susu</span>
			</a>
			<a class="back-link" href="/Landing">Volver al inicio <span aria-hidden="true">→</span></a>
		</header>

		<section class="register-content" aria-labelledby="register-title">
			<div class="register-intro">
				<p class="eyebrow">Un mundo de sabores</p>
				<h1>Tu próxima delicia empieza aquí.</h1>
				<p>Crea tu cuenta para guardar tus favoritos, consultar tus pedidos y recibir inspiración para cada celebración.</p>
				<div class="dessert-note" aria-hidden="true">
					<span>🧁</span>
					<div>
						<strong>Pequeños momentos, grandes sabores</strong>
						<small>Todo lo dulce en un solo lugar</small>
					</div>
				</div>
			</div>

			<div class="register-card">
				<div class="card-heading">
					<h2 id="register-title">Crear una cuenta</h2>
					<p>Regístrate en Delicias Susu y empieza a disfrutar.</p>
				</div>

				<form class="register-form" id="register-form">
					<label for="name">Nombre completo</label>
					<input id="name" name="name" type="text" placeholder="Escribe tu nombre" autocomplete="name" required />

					<label for="email">Correo electrónico</label>
					<input id="email" name="email" type="email" placeholder="tucorreo@ejemplo.com" autocomplete="email" required />

					<label for="phone">Teléfono</label>
					<input id="phone" name="phone" type="tel" placeholder="55 1234 5678" autocomplete="tel" />

					<label for="password">Contraseña</label>
					<input id="password" name="password" type="password" placeholder="Crea una contraseña" autocomplete="new-password" required />

					<label for="password-confirmation">Confirmar contraseña</label>
					<input id="password-confirmation" name="password-confirmation" type="password" placeholder="Repite tu contraseña" autocomplete="new-password" required />

					<label class="terms" for="terms">
						<input id="terms" name="terms" type="checkbox" />
						<span>Acepto los términos y condiciones.</span>
					</label>

					<button class="btn btn-primary" type="submit">Registrarme <span aria-hidden="true">→</span></button>
				</form>
				<p class="system-notification" id="system-notification" role="status" aria-live="polite" hidden>
					Registro exitoso (simulado)
				</p>

				<p class="login-prompt">¿Ya tienes una cuenta? <a href="/Login">Inicia sesión aquí</a></p>
			</div>
		</section>

		<footer class="footer">
			<p>© 2026 Delicias Susu — Postres artesanales con amor.</p>
		</footer>
	</main>
</Layout>

<script>
	const registerForm = document.querySelector<HTMLFormElement>('#register-form');
	const systemNotification = document.querySelector<HTMLElement>('#system-notification');

	registerForm?.addEventListener('submit', (event) => {
		event.preventDefault();
		if (systemNotification) {
			systemNotification.hidden = false;
		}
		window.setTimeout(() => {
			window.location.href = '/Login';
		}, 1500);
	});
</script>

<style>
	.register-shell {
		max-width: 1200px;
		min-height: 100vh;
		margin: 0 auto;
		padding: 24px 20px 36px;
		display: flex;
		flex-direction: column;
	}

	.topbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
	}

	.brand-wrap {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		font-weight: 800;
		color: var(--text);
		letter-spacing: 0.02em;
	}

	.brand-mark {
		display: grid;
		place-items: center;
		width: 42px;
		height: 42px;
		border-radius: 14px;
		background: linear-gradient(135deg, var(--primary) 0%, #eea368 100%);
		color: white;
		box-shadow: var(--shadow);
	}

	.back-link,
	.login-prompt a {
		color: var(--primary-dark);
		font-weight: 700;
	}

	.back-link span {
		margin-left: 5px;
	}

	.register-content {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(360px, 460px);
		align-items: center;
		gap: clamp(48px, 9vw, 130px);
		flex: 1;
		padding: 58px 7% 40px;
	}

	.register-intro h1 {
		max-width: 540px;
		margin: 0;
		font-size: clamp(2.7rem, 5vw, 4.8rem);
		line-height: 1.02;
		letter-spacing: -0.04em;
	}

	.eyebrow {
		margin: 0 0 12px;
		color: var(--primary-dark);
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.register-intro > p:not(.eyebrow) {
		max-width: 500px;
		margin: 20px 0 0;
		color: var(--muted);
		font-size: 1.06rem;
		line-height: 1.7;
	}

	.dessert-note {
		display: inline-flex;
		align-items: center;
		gap: 14px;
		margin-top: 34px;
		padding: 14px 20px 14px 14px;
		border: 1px solid rgba(217, 109, 93, 0.12);
		border-radius: 18px;
		background: rgba(255, 255, 255, 0.65);
		box-shadow: 0 12px 30px rgba(126, 61, 45, 0.07);
	}

	.dessert-note > span {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 14px;
		background: var(--panel-soft);
		font-size: 1.4rem;
	}

	.dessert-note div {
		display: grid;
		gap: 4px;
	}

	.dessert-note small {
		color: var(--muted);
	}

	.register-card {
		padding: clamp(28px, 5vw, 44px);
		border: 1px solid rgba(217, 109, 93, 0.12);
		border-radius: 28px;
		background: rgba(255, 255, 255, 0.82);
		box-shadow: var(--shadow);
	}

	.card-heading h2 {
		margin: 0;
		font-size: 2rem;
		letter-spacing: -0.03em;
	}

	.card-heading p {
		margin: 8px 0 28px;
		color: var(--muted);
	}

	.register-form {
		display: grid;
		gap: 10px;
	}

	.register-form > label:not(.terms) {
		font-size: 0.9rem;
		font-weight: 700;
	}

	.register-form input[type='text'],
	.register-form input[type='email'],
	.register-form input[type='tel'],
	.register-form input[type='password'] {
		width: 100%;
		padding: 12px 16px;
		border: 1px solid var(--line);
		border-radius: 12px;
		background: #fffaf7;
		color: var(--text);
		font: inherit;
		outline: none;
	}

	.register-form input:focus {
		border-color: var(--primary);
		box-shadow: 0 0 0 3px rgba(217, 109, 93, 0.14);
	}

	.terms {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin: 8px 0 14px;
		color: var(--muted);
		font-size: 0.86rem;
	}

	.terms input {
		accent-color: var(--primary);
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		padding: 14px 22px;
		border: 0;
		border-radius: 999px;
		font: inherit;
		font-weight: 700;
		cursor: pointer;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.btn:hover {
		transform: translateY(-1px);
	}

	.btn-primary {
		background: linear-gradient(135deg, var(--primary) 0%, #f08d69 100%);
		color: white;
		box-shadow: 0 16px 32px rgba(217, 109, 93, 0.25);
	}

	.login-prompt {
		margin: 24px 0 0;
		color: var(--muted);
		font-size: 0.9rem;
		text-align: center;
	}

	.system-notification {
		margin: 16px 0 0;
		padding: 12px 16px;
		border: 1px solid rgba(67, 137, 91, 0.22);
		border-radius: 12px;
		background: #edf8ef;
		color: #28643b;
		font-size: 0.9rem;
		font-weight: 700;
		text-align: center;
	}

	.footer {
		padding-top: 20px;
		color: var(--muted);
		font-size: 0.86rem;
		text-align: center;
	}

	@media (max-width: 760px) {
		.register-shell {
			padding-inline: 18px;
		}

		.register-content {
			grid-template-columns: 1fr;
			gap: 36px;
			padding: 64px 0 30px;
		}

		.register-intro h1 {
			font-size: clamp(2.7rem, 13vw, 4rem);
		}

		.register-intro > p:not(.eyebrow) {
			font-size: 1rem;
		}
	}

	@media (max-width: 480px) {
		.back-link {
			font-size: 0.86rem;
		}

		.register-card {
			padding: 26px 20px;
			border-radius: 22px;
		}
	}
</style>
