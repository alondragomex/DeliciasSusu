---
import Layout from '../layouts/Layout.astro';

const products = [
	{
		name: 'Pastel de chocolate',
		description: 'Bizcocho húmedo, ganache artesanal y cacao intenso.',
		price: '$500',
		category: 'Pasteles',
		icon: '🍰',
		className: 'chocolate',
		badge: 'Más vendido',
		availability: 'Entrega en 24 h',
	},
	{
		name: 'Tarta de mango',
		description: 'Crema ligera, base suave y mango natural de temporada.',
		price: '$700',
		category: 'Tartas',
		icon: '🥭',
		className: 'mango',
		badge: 'Favorito',
		availability: 'Entrega en 24 h',
	},
	{
		name: 'Cupcakes surtidos',
		description: 'Seis piezas decoradas a mano con sabores para compartir.',
		price: '$300',
		category: 'Cupcakes',
		icon: '🧁',
		className: 'cupcake',
		badge: 'Para regalar',
		availability: 'Entrega en 12 h',
	},
	{
		name: 'Tarta de frutos rojos',
		description: 'Frutos rojos frescos sobre crema de vainilla y almendra.',
		price: '$650',
		category: 'Tartas',
		icon: '🍓',
		className: 'berries',
		badge: 'De temporada',
		availability: 'Entrega en 24 h',
	},
	{
		name: 'Brownies surtidos',
		description: 'Cuatro brownies de chocolate con nuez y caramelo salado.',
		price: '$320',
		category: 'Regalos',
		icon: '🍫',
		className: 'brownie',
		badge: 'Para compartir',
		availability: 'Entrega en 12 h',
	},
	{
		name: 'Caja desayuno dulce',
		description: 'Mini panqué, galletas, fruta y una bebida para sorprender.',
		price: '$450',
		category: 'Regalos',
		icon: '🎁',
		className: 'gift',
		badge: 'Nuevo',
		availability: 'Entrega en 24 h',
	},
	{
		name: 'Pastel de vainilla',
		description: 'Bizcocho de vainilla con relleno cremoso y decoración artesanal.',
		price: '$550',
		category: 'Pasteles',
		icon: '🎂',
		className: 'vanilla',
		badge: 'Nuevo',
		availability: 'Entrega en 24 h',
	},
	{
		name: 'Galletas decoradas',
		description: 'Galletas de mantequilla decoradas a mano para regalar o celebrar.',
		price: '$280',
		category: 'Regalos',
		icon: '🍪',
		className: 'cookies',
		badge: 'Oferta',
		availability: 'Entrega en 12 h',
	},
];

const categories = ['Todos', 'Pasteles', 'Tartas', 'Cupcakes', 'Regalos'];
---

<Layout>
	<main class="catalog-shell">
		<header class="topbar">
			<a class="brand-wrap" href="/Landing" aria-label="Volver al inicio de Delicias Susu">
				<span class="brand-mark">D</span>
				<span>Delicias Susu</span>
			</a>

			<nav class="nav" aria-label="Navegación principal">
				<a href="/Landing">Inicio</a>
				<a class="active" href="/Catalogo" aria-current="page">Catálogo</a>
				<a href="/Landing#contacto">Contacto</a>
			</nav>

			<a class="login-link" href="/Login">Iniciar sesión <span aria-hidden="true">→</span></a>
			<button class="cart-button" id="cart-button" type="button" aria-label="Carrito, 0 productos">🛒 <span id="cart-count">0</span></button>
		</header>

		<section class="catalog-intro" aria-labelledby="catalog-title">
			<div>
				<p class="eyebrow">Hecho para celebrar</p>
				<h1 id="catalog-title">Elige algo delicioso.</h1>
				<p class="intro-copy">Explora nuestros postres artesanales y encuentra el detalle perfecto para compartir, regalar o darte un gusto.</p>
			</div>
			<div class="catalog-note"><span aria-hidden="true">✦</span><div><strong>Preparado con cariño</strong><small>Ingredientes frescos y recetas caseras</small></div></div>
		</section>

		<section class="catalog-controls" aria-label="Buscar y filtrar productos">
			<label class="search-box" for="product-search">
				<span aria-hidden="true">⌕</span>
				<input id="product-search" type="search" placeholder="Buscar un postre" />
			</label>
			<div class="filters" role="group" aria-label="Categorías de productos">
				{categories.map((category, index) => <button class:list={{ active: index === 0 }} type="button" data-category={category}>{category}</button>)}
			</div>
		</section>

		<section class="catalog-results" aria-labelledby="results-title">
			<div class="results-heading"><div><p class="eyebrow">Nuestro catálogo</p><h2 id="results-title">Dulces para cada momento</h2></div><span id="result-count">{products.length} productos</span></div>
			<div class="product-grid" id="product-grid">
				{products.map((product) => (
					<article class="product-card" data-category={product.category} data-name={product.name.toLowerCase()} data-product={product.name} data-description={product.description} data-price={product.price} data-icon={product.icon} data-class={product.className} data-availability={product.availability}>
						<div class:list={['product-art', product.className]}><span class="product-badge">{product.badge}</span><span class="dessert-icon" aria-hidden="true">{product.icon}</span></div>
						<div class="product-info">
							<div class="category-label">{product.category}</div>
							<h3>{product.name}</h3>
							<p>{product.description}</p>
							<div class="product-footer"><div><strong>{product.price}</strong><small>MXN</small></div><span class="availability">{product.availability}</span></div>
							<button class="order-button" type="button" data-detail-button>Ver detalle <span aria-hidden="true">→</span></button>
						</div>
					</article>
				))}
			</div>
			<p class="empty-state" id="empty-state" hidden>No encontramos postres con ese nombre. Prueba con otra búsqueda.</p>
		</section>

		<div class="product-modal" id="product-modal" hidden>
			<div class="modal-backdrop" data-close-modal></div>
			<article class="detail-panel" role="dialog" aria-modal="true" aria-labelledby="detail-title">
				<button class="close-modal" type="button" aria-label="Cerrar detalle" data-close-modal>×</button>
				<div class="detail-art product-art" id="detail-art"><span class="dessert-icon" id="detail-icon" aria-hidden="true"></span></div>
				<div class="detail-content">
					<p class="category-label" id="detail-category"></p>
					<h2 id="detail-title"></h2>
					<p class="detail-description" id="detail-description"></p>
					<p class="availability" id="detail-availability"></p>
					<div class="detail-purchase"><strong id="detail-price"></strong><span class="quantity-label">Cantidad</span><div class="quantity-control"><button type="button" id="decrease-quantity" aria-label="Disminuir cantidad">−</button><input id="quantity" type="number" min="1" max="20" value="1" aria-label="Cantidad"><button type="button" id="increase-quantity" aria-label="Aumentar cantidad">+</button></div></div>
					<button class="add-cart-button" id="add-cart" type="button">Agregar al carrito <span aria-hidden="true">+</span></button>
					<p class="cart-feedback" id="cart-feedback" role="status" aria-live="polite"></p>
					<section class="related-section" aria-labelledby="related-title"><h3 id="related-title">Productos relacionados</h3><div class="related-grid" id="related-grid"></div></section>
				</div>
			</article>
		</div>

		<div class="cart-modal" id="cart-modal" hidden>
			<div class="modal-backdrop" data-close-cart></div>
			<aside class="cart-panel" role="dialog" aria-modal="true" aria-labelledby="cart-title">
				<div class="cart-heading"><div><p class="eyebrow">Tu selección</p><h2 id="cart-title">Carrito</h2></div><button class="close-modal" type="button" aria-label="Cerrar carrito" data-close-cart>×</button></div>
				<div class="cart-items" id="cart-items"></div>
				<div class="cart-empty" id="cart-empty">Todavía no agregas productos.</div>
				<div class="cart-summary"><div><span>Subtotal</span><strong id="cart-subtotal">$0 MXN</strong></div><div><span>Total</span><strong id="cart-total-price">$0 MXN</strong></div><button class="checkout-button" id="checkout-button" type="button">Ir a pagar <span aria-hidden="true">→</span></button><p class="checkout-feedback" id="checkout-feedback" role="status" aria-live="polite"></p></div>
			</aside>
		</div>

		<section class="catalog-footer">
			<div><p class="eyebrow">¿Tienes algo especial en mente?</p><h2>Personalizamos tu pedido.</h2><p>Cuéntanos tu idea y la convertimos en un detalle hecho especialmente para ti.</p></div>
			<a class="btn btn-primary" href="/Landing#contacto">Hablar con nosotros <span aria-hidden="true">→</span></a>
		</section>

		<footer class="footer"><p>© 2026 Delicias Susu — Postres artesanales con amor.</p><a href="/Landing">Volver al inicio</a></footer>
	</main>
</Layout>

<script>
	const search = document.querySelector<HTMLInputElement>('#product-search');
	const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filters [data-category]');
	const productCards = document.querySelectorAll<HTMLElement>('.product-card');
	const emptyState = document.querySelector<HTMLElement>('#empty-state');
	const resultCount = document.querySelector<HTMLElement>('#result-count');
	const modal = document.querySelector<HTMLElement>('#product-modal');
	const detailArt = document.querySelector<HTMLElement>('#detail-art');
	const detailIcon = document.querySelector<HTMLElement>('#detail-icon');
	const detailCategory = document.querySelector<HTMLElement>('#detail-category');
	const detailTitle = document.querySelector<HTMLElement>('#detail-title');
	const detailDescription = document.querySelector<HTMLElement>('#detail-description');
	const detailAvailability = document.querySelector<HTMLElement>('#detail-availability');
	const detailPrice = document.querySelector<HTMLElement>('#detail-price');
	const quantity = document.querySelector<HTMLInputElement>('#quantity');
	const cartCount = document.querySelector<HTMLElement>('#cart-count');
	const cartButton = document.querySelector<HTMLButtonElement>('#cart-button');
	const relatedGrid = document.querySelector<HTMLElement>('#related-grid');
	const cartFeedback = document.querySelector<HTMLElement>('#cart-feedback');
	const cartModal = document.querySelector<HTMLElement>('#cart-modal');
	const cartItemsElement = document.querySelector<HTMLElement>('#cart-items');
	const cartEmpty = document.querySelector<HTMLElement>('#cart-empty');
	const cartSubtotal = document.querySelector<HTMLElement>('#cart-subtotal');
	const cartTotalPrice = document.querySelector<HTMLElement>('#cart-total-price');
	const checkoutFeedback = document.querySelector<HTMLElement>('#checkout-feedback');
	type CartItem = { name: string; price: number; icon: string; quantity: number };
	let selectedCategory = 'Todos';
	let selectedProduct: HTMLElement | null = null;
	let cartItems: Record<string, CartItem> = JSON.parse(localStorage.getItem('delicias-cart-items') ?? '{}');
	let cartTotal = 0;

	const formatPrice = (price: number) => `$${price.toLocaleString('es-MX')} MXN`;
	const saveCart = () => localStorage.setItem('delicias-cart-items', JSON.stringify(cartItems));

	const updateCartCount = () => {
		cartTotal = Object.values(cartItems).reduce((total, item) => total + item.quantity, 0);
		if (cartCount) cartCount.textContent = String(cartTotal);
		cartButton?.setAttribute('aria-label', `Carrito, ${cartTotal} productos`);
		const subtotal = Object.values(cartItems).reduce((total, item) => total + item.price * item.quantity, 0);
		if (cartSubtotal) cartSubtotal.textContent = formatPrice(subtotal);
		if (cartTotalPrice) cartTotalPrice.textContent = formatPrice(subtotal);
		if (cartEmpty) cartEmpty.hidden = cartTotal !== 0;
	};

	const renderCart = () => {
		if (!cartItemsElement) return;
		cartItemsElement.innerHTML = '';
		Object.values(cartItems).forEach((item) => {
			const row = document.createElement('div');
			row.className = 'cart-item';
			row.innerHTML = `<span class="cart-item-icon">${item.icon}</span><div class="cart-item-info"><strong>${item.name}</strong><small>${formatPrice(item.price)}</small><div class="cart-item-actions"><button type="button" data-cart-action="decrease" data-product="${item.name}" aria-label="Disminuir ${item.name}">−</button><span>${item.quantity}</span><button type="button" data-cart-action="increase" data-product="${item.name}" aria-label="Aumentar ${item.name}">+</button><button class="remove-item" type="button" data-cart-action="remove" data-product="${item.name}">Eliminar</button></div></div><strong>${formatPrice(item.price * item.quantity)}</strong>`;
			cartItemsElement.append(row);
		});
		cartItemsElement.querySelectorAll<HTMLButtonElement>('[data-cart-action]').forEach((button) => button.addEventListener('click', () => {
			const name = button.dataset.product;
			const action = button.dataset.cartAction;
			if (!name || !cartItems[name]) return;
			if (action === 'increase') cartItems[name].quantity = Math.min(20, cartItems[name].quantity + 1);
			if (action === 'decrease') cartItems[name].quantity -= 1;
			if (action === 'remove' || cartItems[name].quantity <= 0) delete cartItems[name];
			saveCart();
			renderCart();
		}));
		updateCartCount();
	};

	const openDetail = (card: HTMLElement) => {
		selectedProduct = card;
		if (!modal || !detailArt || !detailIcon || !detailTitle || !detailDescription || !detailCategory || !detailPrice || !detailAvailability) return;
		detailArt.className = `detail-art product-art ${card.dataset.class ?? ''}`;
		detailIcon.textContent = card.dataset.icon ?? '';
		detailCategory.textContent = card.dataset.category ?? '';
		detailTitle.textContent = card.dataset.product ?? '';
		detailDescription.textContent = card.dataset.description ?? '';
		detailAvailability.textContent = card.dataset.availability ?? '';
		detailPrice.textContent = card.dataset.price ?? '';
		if (quantity) quantity.value = '1';
		if (cartFeedback) cartFeedback.textContent = '';
		if (relatedGrid) {
			relatedGrid.innerHTML = '';
			[...productCards].filter((item) => item !== card && item.dataset.category === card.dataset.category).slice(0, 3).forEach((related) => {
				const button = document.createElement('button');
				button.type = 'button';
				button.className = 'related-item';
				button.innerHTML = `<span>${related.dataset.icon ?? ''}</span><strong>${related.dataset.product ?? ''}</strong><small>${related.dataset.price ?? ''}</small>`;
				button.addEventListener('click', () => openDetail(related));
				relatedGrid.append(button);
			});
		}
		modal.hidden = false;
		document.body.style.overflow = 'hidden';
	};

	const closeDetail = () => {
		if (modal) modal.hidden = true;
		document.body.style.overflow = '';
	};

	const updateProducts = () => {
		const searchTerm = search?.value.trim().toLowerCase() ?? '';
		let visibleCount = 0;
		productCards.forEach((card) => {
			const matchesCategory = selectedCategory === 'Todos' || card.dataset.category === selectedCategory;
			const matchesSearch = !searchTerm || card.dataset.name?.includes(searchTerm);
			const isVisible = matchesCategory && matchesSearch;
			card.hidden = !isVisible;
			if (isVisible) visibleCount += 1;
		});
		if (resultCount) resultCount.textContent = `${visibleCount} ${visibleCount === 1 ? 'producto' : 'productos'}`;
		if (emptyState) emptyState.hidden = visibleCount !== 0;
	};

	filterButtons.forEach((button) => {
		button.addEventListener('click', () => {
			filterButtons.forEach((item) => item.classList.remove('active'));
			button.classList.add('active');
			selectedCategory = button.dataset.category ?? 'Todos';
			updateProducts();
		});
	});
	search?.addEventListener('input', updateProducts);
	productCards.forEach((card) => card.querySelector<HTMLButtonElement>('[data-detail-button]')?.addEventListener('click', () => openDetail(card)));
	document.querySelectorAll<HTMLElement>('[data-close-modal]').forEach((element) => element.addEventListener('click', closeDetail));
	document.querySelector<HTMLButtonElement>('#decrease-quantity')?.addEventListener('click', () => { if (quantity) quantity.value = String(Math.max(1, Number(quantity.value) - 1)); });
	document.querySelector<HTMLButtonElement>('#increase-quantity')?.addEventListener('click', () => { if (quantity) quantity.value = String(Math.min(20, Number(quantity.value) + 1)); });
	document.querySelector<HTMLButtonElement>('#add-cart')?.addEventListener('click', () => {
		if (!selectedProduct || !quantity) return;
		const name = selectedProduct.dataset.product ?? '';
		const amount = Math.max(1, Math.min(20, Number(quantity.value)));
		const price = Number((selectedProduct.dataset.price ?? '$0').replace(/[^\d.]/g, ''));
		cartItems[name] = cartItems[name] ?? { name, price, icon: selectedProduct.dataset.icon ?? '', quantity: 0 };
		cartItems[name].quantity = Math.min(20, cartItems[name].quantity + amount);
		saveCart();
		renderCart();
		if (cartFeedback) cartFeedback.textContent = 'Producto agregado al carrito.';
	});
	cartButton?.addEventListener('click', () => { renderCart(); if (cartModal) cartModal.hidden = false; });
	document.querySelectorAll<HTMLElement>('[data-close-cart]').forEach((element) => element.addEventListener('click', () => { if (cartModal) cartModal.hidden = true; }));
	document.querySelector<HTMLButtonElement>('#checkout-button')?.addEventListener('click', () => { if (checkoutFeedback) checkoutFeedback.textContent = 'Checkout próximamente. Este será el siguiente paso.'; });
	renderCart();
</script>

<style>
	.catalog-shell { max-width: 1200px; margin: 0 auto; padding: 24px 20px 48px; }
	.topbar { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 14px 0 26px; }
	.brand-wrap { display: inline-flex; align-items: center; gap: 12px; color: var(--text); font-weight: 800; letter-spacing: 0.02em; }
	.brand-mark { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 14px; background: linear-gradient(135deg, var(--primary), #eea368); color: white; box-shadow: var(--shadow); }
	.nav { display: flex; gap: 28px; font-size: 0.95rem; }
	.nav a, .login-link { color: var(--muted); font-weight: 600; }
	.nav a:hover, .nav a.active, .login-link { color: var(--primary-dark); }
	.login-link span { margin-left: 5px; }
	.cart-button { border: 0; background: transparent; color: var(--primary-dark); cursor: pointer; font: inherit; font-weight: 800; white-space: nowrap; }
	.cart-button span { display: inline-grid; place-items: center; min-width: 23px; height: 23px; margin-left: 3px; border-radius: 50%; background: var(--primary); color: white; font-size: 0.75rem; }
	.catalog-intro { display: flex; align-items: end; justify-content: space-between; gap: 32px; padding: 58px 0 44px; }
	.eyebrow { margin: 0 0 11px; color: var(--primary-dark); font-size: 0.78rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; }
	.catalog-intro h1 { max-width: 650px; margin: 0; font-size: clamp(2.8rem, 6vw, 5.2rem); line-height: 0.98; letter-spacing: -0.05em; }
	.intro-copy { max-width: 560px; margin: 20px 0 0; color: var(--muted); font-size: 1.06rem; line-height: 1.7; }
	.catalog-note { display: inline-flex; align-items: center; gap: 14px; min-width: 265px; padding: 14px 18px 14px 14px; border: 1px solid rgba(217, 109, 93, 0.13); border-radius: 18px; background: rgba(255, 255, 255, 0.72); box-shadow: 0 12px 30px rgba(126, 61, 45, 0.07); }
	.catalog-note > span { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 14px; background: var(--panel-soft); color: var(--primary-dark); font-size: 1.3rem; }
	.catalog-note div { display: grid; gap: 4px; }
	.catalog-note small { color: var(--muted); }
	.catalog-controls { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 18px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
	.search-box { display: flex; align-items: center; gap: 9px; width: min(100%, 250px); padding: 11px 14px; border: 1px solid var(--line); border-radius: 12px; background: white; color: var(--muted); }
	.search-box input { width: 100%; border: 0; outline: 0; background: transparent; color: var(--text); font: inherit; }
	.filters { display: flex; flex-wrap: wrap; justify-content: end; gap: 8px; }
	.filters button { padding: 9px 15px; border: 1px solid var(--line); border-radius: 999px; background: transparent; color: var(--muted); cursor: pointer; font: inherit; font-size: 0.9rem; }
	.filters button:hover, .filters button.active { border-color: var(--primary); background: var(--primary); color: white; }
	.catalog-results { padding: 55px 0 70px; }
	.results-heading { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 24px; }
	.results-heading h2 { margin: 0; font-size: clamp(1.8rem, 3vw, 2.7rem); line-height: 1.05; letter-spacing: -0.04em; }
	.results-heading > span { color: var(--muted); font-size: 0.9rem; }
	.product-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
	.product-card { overflow: hidden; border: 1px solid var(--line); border-radius: 22px; background: var(--panel); box-shadow: 0 12px 35px rgba(126, 61, 45, 0.06); transition: transform 0.2s ease, box-shadow 0.2s ease; }
	.product-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
	.product-art { position: relative; display: grid; place-items: center; min-height: 185px; overflow: hidden; }
	.product-art::after { position: absolute; right: -26px; bottom: -50px; width: 150px; height: 150px; border-radius: 50%; background: rgba(255, 255, 255, 0.18); content: ''; }
	.product-art.chocolate { background: #6b3d36; }
	.product-art.mango { background: #f4bd55; }
	.product-art.cupcake { background: #e79aa2; }
	.product-art.berries { background: #bd6c7e; }
	.product-art.brownie { background: #8d5b43; }
	.product-art.gift { background: #75a49a; }
	.product-badge { position: absolute; top: 16px; left: 16px; z-index: 1; padding: 6px 9px; border-radius: 999px; background: rgba(255, 255, 255, 0.88); color: var(--text); font-size: 0.72rem; font-weight: 800; }
	.dessert-icon { position: relative; z-index: 1; font-size: 5.8rem; filter: drop-shadow(0 12px 7px rgba(66, 31, 22, 0.22)); }
	.product-info { padding: 19px 20px 20px; }
	.category-label { color: var(--primary-dark); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
	.product-info h3 { margin: 7px 0 8px; font-size: 1.25rem; }
	.product-info p { min-height: 48px; margin: 0; color: var(--muted); font-size: 0.9rem; line-height: 1.55; }
	.product-footer { display: flex; align-items: end; justify-content: space-between; gap: 12px; margin: 18px 0 15px; }
	.product-footer div { display: flex; align-items: baseline; gap: 4px; }
	.product-footer strong { font-size: 1.45rem; }
	.product-footer small { color: var(--muted); font-size: 0.7rem; }
	.availability { color: var(--muted); font-size: 0.72rem; text-align: right; }
	.order-button, .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; font-weight: 800; }
	.order-button { width: 100%; padding: 11px 15px; border-radius: 11px; background: var(--panel-soft); color: var(--primary-dark); }
	.order-button:hover { background: #ffe2d6; }
	.product-modal[hidden] { display: none; }
	.product-modal { position: fixed; inset: 0; z-index: 10; display: grid; place-items: center; padding: 20px; }
