---
import Layout from '../layouts/Layout.astro';
---

<Layout>
    <main class="login-shell">
        <header class="topbar">
            <a class="brand-wrap" href="/" aria-label="Volver al inicio de Delicias Susu">
                <span class="brand-mark">D</span>
                <span>Delicias Susu</span>
            </a>
            <a class="back-link" href="/Landing">Volver al inicio <span aria-hidden="true">→</span></a>
        </header>

        <section class="login-content" aria-labelledby="login-title">
            <div class="login-intro">
                <p class="eyebrow">Tu rincón dulce</p>
                <h1 id="login-title">Qué gusto verte de nuevo.</h1>
                <p>Ingresa para consultar tus pedidos, guardar tus sabores favoritos y preparar tu próxima celebración.</p>
                <div class="dessert-note" aria-hidden="true">
                    <span>🍰</span>
                    <div>
                        <strong>Momentos hechos a mano</strong>
                        <small>Postres que saben a casa</small>
                    </div>
                </div>
            </div>

            <div class="login-card">
                <div class="card-heading">
                    <h2>Iniciar sesión</h2>
                    <p>Accede a tu cuenta de Delicias Susu.</p>
                </div>

                <form class="login-form">
                    <label for="email">Correo electrónico</label>
                    <input id="email" name="email" type="email" placeholder="tucorreo@ejemplo.com" autocomplete="email" required />

                    <div class="password-label">
                        <label for="password">Contraseña</label>
                        <a href="#recuperar">¿La olvidaste?</a>
                    </div>
                    <input id="password" name="password" type="password" placeholder="Escribe tu contraseña" autocomplete="current-password" required />

                    <label class="remember-me" for="remember">
                        <input id="remember" name="remember" type="checkbox" />
                        <span>Recordar mi sesión</span>
                    </label>

                    <button class="btn btn-primary" type="submit">Entrar a mi cuenta <span aria-hidden="true">→</span></button>
                </form>

                <p class="signup-prompt">¿Aún no tienes una cuenta? <a href="#registro">Regístrate aquí</a></p>
            </div>
        </section>

        <footer class="footer">
            <p>© 2026 Delicias Susu — Postres artesanales con amor.</p>
        </footer>
    </main>
</Layout>

<style>
    .login-shell {
        max-width: 1200px;
        min-height: 100vh;
        margin: 0 auto;
        padding: 24px 20px 36px;
        display: flex;
        flex-direction: column;
    }

    .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }

    .brand-wrap {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        font-weight: 800;
        color: var(--text);
        letter-spacing: 0.02em;
    }

    .brand-mark {
        display: grid;
        place-items: center;
        width: 42px;
        height: 42px;
        border-radius: 14px;
        background: linear-gradient(135deg, var(--primary) 0%, #eea368 100%);
        color: white;
        box-shadow: var(--shadow);
    }

    .back-link,
    .password-label a,
    .signup-prompt a {
        color: var(--primary-dark);
        font-weight: 700;
    }

    .back-link span {
        margin-left: 5px;
    }

    .login-content {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(360px, 460px);
        align-items: center;
        gap: clamp(48px, 9vw, 130px);
        flex: 1;
        padding: 58px 7% 40px;
    }

    .login-intro h1 {
        max-width: 540px;
        margin: 0;
        font-size: clamp(2.7rem, 5vw, 4.8rem);
        line-height: 1.02;
        letter-spacing: -0.04em;
    }

    .eyebrow {
        margin: 0 0 12px;
        color: var(--primary-dark);
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .login-intro > p:not(.eyebrow) {
        max-width: 500px;
        margin: 20px 0 0;
        color: var(--muted);
        font-size: 1.06rem;
        line-height: 1.7;
    }

    .dessert-note {
        display: inline-flex;
        align-items: center;
        gap: 14px;
        margin-top: 34px;
        padding: 14px 20px 14px 14px;
        border: 1px solid rgba(217, 109, 93, 0.12);
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.65);
        box-shadow: 0 12px 30px rgba(126, 61, 45, 0.07);
    }

    .dessert-note > span {
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        border-radius: 14px;
        background: var(--panel-soft);
        font-size: 1.4rem;
    }

    .dessert-note div {
        display: grid;
        gap: 4px;
    }

    .dessert-note small {
        color: var(--muted);
    }

    .login-card {
        padding: clamp(28px, 5vw, 44px);
        border: 1px solid rgba(217, 109, 93, 0.12);
        border-radius: 28px;
        background: rgba(255, 255, 255, 0.82);
        box-shadow: var(--shadow);
    }

    .card-heading h2 {
        margin: 0;
        font-size: 2rem;
        letter-spacing: -0.03em;
    }

    .card-heading p {
        margin: 8px 0 28px;
        color: var(--muted);
    }

    .login-form {
        display: grid;
        gap: 10px;
    }

    .login-form label {
        font-size: 0.9rem;
        font-weight: 700;
    }

    .login-form input[type='email'],
    .login-form input[type='password'] {
        width: 100%;
        padding: 14px 16px;
        border: 1px solid var(--line);
        border-radius: 12px;
        background: #fffaf7;
        color: var(--text);
        font: inherit;
        outline: none;
    }

    .login-form input[type='email']:focus,
    .login-form input[type='password']:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(217, 109, 93, 0.14);
    }

    .password-label {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-top: 12px;
    }

    .password-label a {
        font-size: 0.82rem;
    }

    .remember-me {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin: 8px 0 14px;
        color: var(--muted);
        font-weight: 400 !important;
    }

    .remember-me input {
        accent-color: var(--primary);
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 14px 22px;
        border: 0;
        border-radius: 999px;
        font: inherit;
        font-weight: 700;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .btn:hover {
        transform: translateY(-1px);
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--primary) 0%, #f08d69 100%);
        color: white;
        box-shadow: 0 16px 32px rgba(217, 109, 93, 0.25);
    }

    .signup-prompt {
        margin: 24px 0 0;
        color: var(--muted);
        font-size: 0.9rem;
        text-align: center;
    }

    .footer {
        padding-top: 20px;
        color: var(--muted);
        font-size: 0.86rem;
        text-align: center;
    }

    @media (max-width: 760px) {
        .login-shell {
            padding-inline: 18px;
        }

        .login-content {
            grid-template-columns: 1fr;
            gap: 36px;
            padding: 64px 0 30px;
        }

        .login-intro h1 {
            font-size: clamp(2.7rem, 13vw, 4rem);
        }

        .login-intro > p:not(.eyebrow) {
            font-size: 1rem;
        }
    }

    @media (max-width: 480px) {
        .back-link {
            font-size: 0.86rem;
        }

        .login-card {
            padding: 26px 20px;
            border-radius: 22px;
        }
    }
</style>